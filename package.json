    "test:assessment": "node tests/assessment-browser.cjs",
    "test:workflow": "node tests/workflow-browser.cjs",
    "test:resources": "node tests/resources-browser.cjs",
    "test:document-completion": "node tests/document-completion-browser.cjs",
    "test:catalog-completion": "node tests/catalog-completion-browser.cjs",
